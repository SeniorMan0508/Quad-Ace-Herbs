# QUAD-ACE HERBS - ENVIRONMENT CONFIGURATION (OPTIONAL)
# Copy this file to .env and fill in your values if you want real Gmail email delivery.
# If not provided, the server will simulate email sending and log the 6-digit verification code in the server terminal!

# Web Server Port (Defaults to 3000)
PORT=3000

# Owner's Email for Password Resets
ADMIN_EMAIL=badmusdaniel0508@gmail.com

# SMTP Settings for sending real reset code emails:
# For Gmail, generate an "App Password" at: https://myaccount.google.com/apppasswords
SMTP_SERVICE=gmail
SMTP_USER=badmusdaniel0508@gmail.com
SMTP_PASS=your-16-character-gmail-app-password
